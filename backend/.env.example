# Database and storage paths
OMNIASSIST_DATABASE_PATH=./data/omniassist.db
OMNIASSIST_UPLOAD_DIR=./data/uploads
OMNIASSIST_MAX_UPLOAD_BYTES=7340032

# AI Model Provider Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_INPUT=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_INPUT=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_IMAGE_INPUT=true

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_IMAGE_INPUT=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Web Client and Security
OMNIASSIST_WEB_ORIGIN=http://localhost:5173
OMNIASSIST_AUTH_SECRET=replace-with-a-long-random-secret
OMNIASSIST_REGISTRATION_INVITE_CODE=
OMNIASSIST_DAILY_PROVIDER_REQUEST_LIMIT=0
OMNIASSIST_USAGE_RETENTION_DAYS=90

# Live Media & Real-time Voice
GEMINI_LIVE_MODEL=gemini-3.8-live
OMNIASSIST_LIVE_ENABLED=true

# Sourced Web Search
TAVILY_API_KEY=

# Optional model pricing configuration for token cost estimation
OMNIASSIST_MODEL_PRICING_JSON={}
