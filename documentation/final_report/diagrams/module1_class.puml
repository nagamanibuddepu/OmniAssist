@startuml
skinparam backgroundColor #FFFFFF
class WorkspaceState {
    + activeConversationId: string
    + models: Model[]
    + selectedModelId: string
    + isStreaming: boolean
    + webSearchEnabled: boolean
    + attachments: UploadedFile[]
    + selectConversation(id: string): void
    + sendMessage(text: string): Promise<void>
    + stopGeneration(): void
}
class ChatComposer {
    + inputContent: string
    + isRecording: boolean
    + handleFileUpload(file: File): void
    + triggerDictation(): void
    + openModelMenu(): void
}
class SidepanelCompanion {
    + activeTabId: number
    + pageContent: string
    + captureTabScreenshot(): Promise<Blob>
    + explainSelection(): void
    + startTabLiveSession(): void
}
class ActionCard {
    + actionId: string
    + actionType: string
    + payload: object
    + status: string
    + handleApprove(): void
    + handleReject(): void
}
WorkspaceState *-- ChatComposer
WorkspaceState *-- ActionCard
SidepanelCompanion ..> WorkspaceState : Synchronizes via API
@enduml